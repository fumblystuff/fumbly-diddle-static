{
  "name": "fumbly-diddle-static",
  "version": "1.0.4",
  "description": "Static web site for https://fumblydiddle.com",
  "main": "eleventy.config.js",
  "scripts": {
    "clean": "rimraf _site",
    "build:eleventy": "eleventy",
